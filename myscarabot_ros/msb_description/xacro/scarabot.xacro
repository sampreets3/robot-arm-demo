<robot name="scara_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
 
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
 
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0" />
  </material>
 
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0" />
  </material>
 
  <link name="base">
    <visual>
        <geometry>
          <cylinder radius="0.1" length="0.05" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <material name="blue" />
    </visual>  
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.3" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.15" />
      <material name="blue" />
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.1" length="0.3" />
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <visual>
      <geometry>
        <box size="0.3 0.1 0.05" />
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0" />
      <material name="white"/>
    </visual>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <material name="white"/>
    </visual>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05" />
      </geometry>
      <origin rpy="0 0 0" xyz="0.3 0 0" />
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.4 0.1 0.05" />
      </geometry>
    </collision>
  </link>

  <link name="link_2">
    <visual>
      <geometry>
        <box size="0.3 0.1 0.15" />
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0" />
      <material name="white"/>
    </visual>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.15" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <material name="white"/>
    </visual>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.15" />
      </geometry>
      <origin rpy="0 0 0" xyz="0.3 0 0" />
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.4 0.1 0.15" />
      </geometry>
    </collision>
  </link>

  <link name="link_3">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.3" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.1" />
      <material name="black" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.3" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.1" />
      <material name="black" />
    </collision>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
      <material name="black" />
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
      <material name="red" />
    </collision>
  </link>

  <!-- JOINTS -->

  <joint name="joint_1" type="revolute">
    <parent link="base" />
    <child link="link_1" />
    <limit lower="-2.356" upper="2.356" effort="10.0" velocity="1.0"/>
    <origin rpy="0 0 0" xyz="0 0 0.25" />
    <axis xyz="0 0 1" />
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin rpy="0 0 0" xyz="0.3 0 0.05" />
    <limit lower="-2.356" upper="2.356" effort="10.0" velocity="1.0"/>
    <axis xyz="0 0 1" />
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2" />
    <child link="link_3" />
    <origin rpy="0 0 0" xyz="0.3 0 -0.05" />
    <limit lower="0.0" upper="0.2" effort="10.0" velocity="1.0"/>
    <axis xyz="0 0 -1" />
  </joint>

  <joint name="joint_4" type="continuous">
    <parent link="link_3" />
    <child link="link_4" />
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.05" />
    <axis xyz="0.0 0.0 1.0"/>
  </joint>
</robot>
